# ── Datenbank ────────────────────────────────────────────────────────────────
DATABASE_URL="file:../data/app.db"

# ── Session ──────────────────────────────────────────────────────────────────
# Beliebige lange Zufallszeichenkette (z. B. `openssl rand -hex 32`)
AUTH_SECRET="bitte-aendern-langer-zufallsstring"

# ── Buch-Metadaten-Provider ──────────────────────────────────────────────────
# openlibrary (kein Key nötig) | googlebooks | none
BOOK_PROVIDER="openlibrary"
GOOGLE_BOOKS_API_KEY=""

# ── Bildsuche fürs Moodboard ─────────────────────────────────────────────────
# unsplash | pexels | none  (ohne Key: Upload + Farbflächen funktionieren weiterhin)
IMAGE_PROVIDER="none"
UNSPLASH_ACCESS_KEY=""
PEXELS_API_KEY=""

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Erzeugen mit: npm run push:keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# ── Wartung ──────────────────────────────────────────────────────────────────
# Schlüssel für POST /api/maintenance/reminders (Cron). Leer = Route deaktiviert.
MAINTENANCE_KEY=""
